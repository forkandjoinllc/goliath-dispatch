# ─────────────────────────────────────────────────────────────────────────────
# Goliath Dispatch — environment template
# Copy to `.env` for local development. NEVER commit a filled-in .env.
# Every value below is a placeholder; no production credential belongs here.
# ─────────────────────────────────────────────────────────────────────────────

# --- Core ---------------------------------------------------------------
NODE_ENV=development
APP_ENV=development                       # development | staging | production
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Goliath Dispatch

# --- Database (Supabase Postgres or any Postgres 15+) -------------------
# Local dev default; in Supabase use the "Connection pooling" URI for runtime
# and the direct URI for migrations.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/goliath_dev
DATABASE_URL_UNPOOLED=postgres://postgres:postgres@127.0.0.1:5432/goliath_dev
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/goliath_test

# --- Supabase (optional; auth is self-hosted by default) ----------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cryptography -------------------------------------------------------
# 32-byte base64 keys. Generate: openssl rand -base64 32
AUTH_SECRET=REPLACE_ME_generate_with_openssl_rand_base64_32
ENCRYPTION_KEY=REPLACE_ME_generate_with_openssl_rand_base64_32
ENCRYPTION_KEY_PREVIOUS=                  # set during key rotation only
SIGNATURE_HASH_PEPPER=REPLACE_ME_generate_with_openssl_rand_base64_32
PUBLIC_TRACKING_TOKEN_SECRET=REPLACE_ME_generate_with_openssl_rand_base64_32
CRON_SECRET=REPLACE_ME_generate_with_openssl_rand_base64_32

# --- Object storage (S3-compatible, PRIVATE bucket) ---------------------
STORAGE_DRIVER=local                      # local | s3
S3_REGION=us-east-1
S3_BUCKET=goliath-dispatch-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=                              # set for MinIO / Supabase Storage / R2
S3_FORCE_PATH_STYLE=false
SIGNED_URL_TTL_SECONDS=300
LOCAL_STORAGE_ROOT=./.local-storage       # used when STORAGE_DRIVER=local

# --- Stripe -------------------------------------------------------------
STRIPE_DRIVER=mock                        # mock | live
STRIPE_SECRET_KEY=sk_test_placeholder
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_PRICE_STARTER=price_placeholder_starter
STRIPE_PRICE_GROWTH=price_placeholder_growth
STRIPE_PRICE_ENTERPRISE=price_placeholder_enterprise

# --- Twilio (SMS) -------------------------------------------------------
SMS_DRIVER=mock                           # mock | twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=

# --- Mailgun (transactional email) --------------------------------------
EMAIL_DRIVER=mock                         # mock | mailgun
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_REGION=us                         # us | eu
EMAIL_FROM="Goliath Dispatch <no-reply@example.com>"

# --- Google Maps / Places / Routes --------------------------------------
GEO_DRIVER=mock                           # mock | google
GOOGLE_MAPS_SERVER_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_API_KEY=

# --- FMCSA public data ---------------------------------------------------
FMCSA_DRIVER=mock                         # mock | qcmobile
FMCSA_WEBKEY=
FMCSA_BASE_URL=https://mobile.fmcsa.dot.gov/qc/services

# --- OCR / document extraction (VIN from COI) ---------------------------
OCR_DRIVER=mock                           # mock | textract | docai
AWS_TEXTRACT_REGION=us-east-1

# --- Malware scanning ----------------------------------------------------
MALWARE_SCAN_DRIVER=noop                  # noop | clamav

# --- Tracking providers ---------------------------------------------------
TRACKING_DEFAULT_PROVIDER=mock            # mock | trucker_tools | macropoint | highway
TRUCKER_TOOLS_API_KEY=
MACROPOINT_API_KEY=
HIGHWAY_API_KEY=

# --- Tolls (future adapter, not implemented live) ------------------------
TOLLGURU_API_KEY=

# --- Background jobs ------------------------------------------------------
JOBS_DRIVER=database                      # database | qstash
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# --- Rate limiting --------------------------------------------------------
RATE_LIMIT_DRIVER=memory                  # memory | database
PUBLIC_FORM_RATE_LIMIT_PER_HOUR=10

# --- Observability --------------------------------------------------------
LOG_LEVEL=info                            # debug | info | warn | error
LOG_FORMAT=pretty                         # pretty | json

# --- Seed / demo ----------------------------------------------------------
SEED_DEMO_PASSWORD=DemoPassw0rd!2026      # local development only
ALLOW_DEMO_SEED=true                      # must be false in production
