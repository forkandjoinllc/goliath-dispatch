# ─────────────────────────────────────────────────────────────────────────────
# Goliath Dispatch — variables de entorno
#
# Este fichero es la PLANTILLA y va en el repositorio. Nunca lleva un valor
# real: todo lo que aparezca aquí es público. Los valores de producción se
# ponen en el editor de entorno de Forge, que los guarda solo en el servidor.
#
# Regla de la especificación, y se cumple: los servicios externos usan
# adaptadores simulados cuando no hay credenciales. La aplicación arranca y
# funciona sin una sola clave de tercero — no se cae, cambia de adaptador.
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME="Goliath Dispatch"
APP_ENV=production
# Se genera en el servidor con `php artisan key:generate`. Vacío aquí a
# propósito: una APP_KEY en el repositorio firma los tokens de formulario y
# cifra las cookies de sesión de cualquiera que lo lea.
APP_KEY=
APP_DEBUG=false
APP_URL=https://goliathdispatch.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

# 12 rondas. Es lo que tarda ~200 ms en este hardware, que es el coste que hace
# cara la fuerza bruta. En las pruebas se baja a 4 (ver phpunit.xml).
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ── Base de datos ────────────────────────────────────────────────────────────
# MySQL, no SQLite: el esquema son 15 ficheros de DDL MySQL en crudo (columnas
# generadas STORED, CHECK, triggers con SIGNAL, claves foráneas compuestas).
# Ver docs/mysql-port.md.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=goliath_dispatch
DB_USERNAME=
DB_PASSWORD=
# La colación con la que se crean las tablas. Si la conexión usara otra,
# comparar una columna con un literal fallaría con "Illegal mix of collations".
DB_COLLATION=utf8mb4_0900_ai_ci
# La aplicación es UTC de punta a punta.
DB_TIMEZONE=+00:00

# ── Sesión ───────────────────────────────────────────────────────────────────
# database, no file ni cookie: la empresa activa y el estado del segundo factor
# viven en COLUMNAS de `sessions` (active_tenant_id, mfa_satisfied_at,
# revoked_at), y eso exige que la sesión esté en la base de datos.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ── Colas ────────────────────────────────────────────────────────────────────
# Horizon exige Redis. Sin Redis disponible, poner QUEUE_CONNECTION=database y
# no arrancar Horizon: los trabajos se procesan igual, más despacio.
QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Renderizado en servidor ──────────────────────────────────────────────────
# El sitio público se renderiza en el servidor para que un buscador vea el texto
# y no un div vacío. El proceso se declara como demonio en Forge:
#   php artisan inertia:start-ssr
INERTIA_SSR_ENABLED=true
INERTIA_SSR_URL=http://127.0.0.1:13714

# ── Correo ───────────────────────────────────────────────────────────────────
# Sin credenciales, `log` escribe los correos en el registro en vez de fallar.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@goliathdispatch.com"
MAIL_FROM_NAME="${APP_NAME}"
MAILGUN_DOMAIN=
MAILGUN_SECRET=

# ── Almacenamiento de documentos ─────────────────────────────────────────────
# Sin credenciales de AWS se usa el disco local. Para producción de verdad hace
# falta S3: los documentos de cumplimiento tienen retención de siete años y el
# disco de un servidor que se reprovisiona no es un sitio donde guardarlos.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Servicios externos ───────────────────────────────────────────────────────
# Todos opcionales. Vacíos = adaptador simulado, comprobable y sin red.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# FMCSA — QCMobile. Sin clave se ata el adaptador simulado, que lo dice en
# pantalla y en cada fila que escribe. Se pide en
# https://mobile.fmcsa.dot.gov/QCDevsite/ — el valor real vive SOLO en el .env
# del servidor.
FMCSA_WEBKEY=
FMCSA_BASE_URL=https://mobile.fmcsa.dot.gov/qc/services

# ── Firmas ───────────────────────────────────────────────────────────────────
# Clave del sello de integridad de cada firma. Si se deja vacía se DERIVA de
# APP_KEY y la aplicación funciona igual — pero entonces rotar APP_KEY invalida
# todos los sellos anteriores. En producción, pon aquí un valor propio y no lo
# cambies nunca. Genera uno con: php -r "echo bin2hex(random_bytes(32));"
SIGNATURE_HASH_PEPPER=

# ── Legal ────────────────────────────────────────────────────────────────────
# Se graba en cada consent_records. Súbela cuando cambien los textos legales:
# los consentimientos nuevos quedan atados al texto nuevo y los viejos siguen
# siendo válidos para el que sí aceptaron.
LEGAL_POLICY_VERSION=2026-08-20

VITE_APP_NAME="${APP_NAME}"

# Purga permanente de registros vencidos. Apagada de fábrica: archivar se
# deshace, purgar no. Ver docs/retention.md antes de encenderla.
RETENTION_PURGE_ENABLED=false
